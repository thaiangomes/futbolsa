# Copie para .env (ou exporte no terminal). Nunca commite valores reais: .env fica fora do git.

# Chave da API football-data.org (https://www.football-data.org/client/register).
FOOTBALL_DATA_KEY=

# Banco do jogo: Postgres do projeto hospedado no Supabase (usado a partir da F4).
# No painel: Connect > Connection String > Session pooler (o Transaction pooler não segura as
# travas de uma transação). Acrescente o SSL verificado pelo certificado do Supabase
# (Project Settings > Database > SSL Configuration > Download certificate), salvo fora do repositório:
#   postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=<caminho>/supabase-ca.crt
# Depois de migrar, `apps/api/scripts/check-exposure.sql` confere que a chave pública não vê as tabelas.
DATABASE_URL=
# Postgres de teste do docker compose (porta 5433).
TEST_DATABASE_URL=postgres://futbolsa:futbolsa@localhost:5433/futbolsa_test

# Supabase: login (usado a partir da F5). A chave de serviço é segredo, só da API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço do site (CORS da API) e da API (lido pelo site na hora do build).
WEB_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# Porta da API.
PORT=3000
