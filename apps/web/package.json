{
  "name": "@futbolsa/web",
  "version": "0.0.1",
  "private": true,
  "description": "Site do FutBolsa (Next.js em exportação estática)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e:build": "node e2e/build.mjs",
    "e2e": "npm run e2e:build && playwright test -c e2e/playwright.config.ts",
    "e2e:supabase": "node e2e/supabase/executar.mjs",
    "e2e:testar": "playwright test -c e2e/playwright.config.ts",
    "partida:site": "node e2e/build.mjs --api http://127.0.0.1:3200 --saida out-partida"
  },
  "devDependencies": {
    "@futbolsa/engine": "*",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@futbolsa/contracts": "*",
    "@supabase/supabase-js": "^2.118.0",
    "lightweight-charts": "^5.2.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
