{
  "name": "futbolsa",
  "version": "0.0.1",
  "private": true,
  "description": "Bolsa de valores fictícia com clubes de futebol brasileiros",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:libs": "npm run build -w @futbolsa/engine -w @futbolsa/contracts",
    "pretest": "npm run build:libs",
    "pretypecheck": "npm run build:libs",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sim": "npm run sim -w @futbolsa/engine --",
    "sim:lote": "npm run sim:lote -w @futbolsa/engine --",
    "sim:regressao": "npm run sim:regressao -w @futbolsa/engine --",
    "data:convert": "npm run data:convert -w @futbolsa/engine --",
    "data:fetch": "npm run data:fetch -w @futbolsa/engine --",
    "data:convert-copa": "npm run data:convert-copa -w @futbolsa/engine --",
    "data:fetch-espn-copa": "npm run data:fetch-espn-copa -w @futbolsa/engine --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
