{
  "name": "futbolsa",
  "version": "0.0.1",
  "private": true,
  "description": "Bolsa de valores fictícia com clubes de futebol brasileiros",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
